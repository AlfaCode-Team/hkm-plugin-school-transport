{
    "name": "alfacode-team/hkm-plugin-school-transport",
    "description": "School bus routes, trips, checkpoints, passengers, bus cards and boarding scans.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolTransport\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolTransport\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
